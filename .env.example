# Environment Configuration Example
# Copy this file to .env and fill in the values

# Node Environment
NODE_ENV=development

# Database Configuration
# Required in production - PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:port/database

# Inngest Configuration (Production)
# Optional - defaults to "replit-agent-workflow" if not set
INNGEST_APP_ID=replit-agent-workflow
# Optional - defaults to "Replit Agent Workflow System" if not set
INNGEST_APP_NAME=Replit Agent Workflow System
# Optional - Inngest event key for secure event sending
INNGEST_EVENT_KEY=
# Optional - Inngest signing key for webhook verification
INNGEST_SIGNING_KEY=
# Optional - Override the serve host URL (auto-detected from REPLIT_DOMAINS if not set)
INNGEST_SERVE_HOST=

# Replit Configuration (Auto-provided in Replit deployments)
# REPLIT_DOMAINS will be automatically set by Replit
# REPLIT_DOMAINS=your-repl.replit.app

# Telegram Bot Configuration
# Required for Telegram integration
TELEGRAM_BOT_TOKEN=

# AI Provider Configuration
# Configure your preferred AI provider
OPENAI_API_KEY=
GROQ_API_KEY=
# Or use other providers as needed

# Mastra Configuration
MASTRA_HIDE_CLOUD_CTA=true
